# Optional server-side Gemini summary. The core comparison works without it.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Override only when intentionally selecting a compatible Gemini model.
GEMINI_MODEL=gemini-2.5-flash
# Used only by scripts/generate-narration.mjs, never exposed to the browser.
ELEVENLABS_API_KEY=
# Server-only URL for the restricted Tiger application role; the administrative URL is migration-only.
DATABASE_URL=
# Local migration safety check; must match the database name in DATABASE_URL.
MIGRATION_CONFIRM_DB=tsdb
