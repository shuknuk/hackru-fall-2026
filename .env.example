# Optional server-side Gemini summary. The core comparison works without it.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Override only when intentionally selecting a compatible Gemini model.
GEMINI_MODEL=gemini-2.5-flash
# Used only by scripts/generate-narration.mjs, never exposed to the browser.
ELEVENLABS_API_KEY=
# Server-only URL for the restricted Tiger application role; the administrative URL is migration-only.
DATABASE_URL=
# Clerk keys from the same Clerk application. Never expose CLERK_SECRET_KEY to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Pin the browser bundles to the versions validated with @clerk/nextjs 7.9.14.
NEXT_PUBLIC_CLERK_JS_VERSION=6.39.0
NEXT_PUBLIC_CLERK_UI_VERSION=1.40.0
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Local migration safety check; must match the database name in DATABASE_URL.
MIGRATION_CONFIRM_DB=tsdb
